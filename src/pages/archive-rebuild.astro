---
import '../styles/global.css';
import '../styles/line-actions.css';
import '../styles/archive/wheel-disclosure.css';
import '../styles/archive-rebuild.css';
import '../styles/archive-portrait.css';
import WorksMap from '../components/WorksMap.astro';
import AudioHud from '../components/audio/AudioHud.astro';
import DrawerTrigger from '../components/ui/DrawerTrigger.astro';
import TagFilter from '../components/filters/TagFilter.astro';
import YearFilter from '../components/filters/YearFilter.astro';
import ArchiveWheel from '../components/works/ArchiveWheel.astro';
import PointPreview from '../components/works/PointPreview.astro';
import Footer from '../components/layout/Footer.astro';
import StartOverlay from '../components/startup/StartOverlay.astro';
import { works, wheelEntries } from '../data/works';


const allTags = [...new Set(works.flatMap(work => work.tags ?? []))].sort();
const allYears = [...new Set(works.map(work => String(work.year)))].sort().reverse();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>Talich Helfen | Graph and Archive Rebuild</title>
  </head>
  <body class="archive-trial archive-rebuild is-blurred bg-zinc-950 text-zinc-200 min-h-screen">
    <StartOverlay archivePreview />
    <div id="archive-content" inert>
      <button type="button" data-archive-stop aria-label="Stop archive">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path data-stop-icon d="M3 3h10v10H3z"/><path data-resume-icon d="M4 2.5 13 8l-9 5.5z"/></svg>
      </button>
      <div id="archive-scene">
        <div id="archive-trial-controls">
          <DrawerTrigger class="trial-disclosure trial-audio-launcher" data-trial-panel="audio" controls="trial-audio" aria-label="Setting: Audio & Space"><span class="line-action"><span class="line-action__word">Setting</span></span><span class="trial-audio-status" aria-live="polite" data-preview-audio-status></span></DrawerTrigger>
          <section id="trial-audio" class="trial-drawer" aria-labelledby="trial-audio-title" hidden>
            <div class="trial-audio-heading"><h2 id="trial-audio-title">Audio &amp; Space</h2><button type="button" class="trial-audio-close line-action" aria-label="Close audio controls"><span class="line-action__word">Close</span></button></div>
            <AudioHud preview />
          </section>
          <DrawerTrigger class="trial-disclosure line-action" data-trial-panel="tag" controls="trial-tag"><span class="line-action__word">Tag</span><span class="trial-filter-value" data-trial-filter-value aria-hidden="true" hidden></span></DrawerTrigger>
          <section id="trial-tag" class="trial-drawer trial-filter" aria-label="Tag filter" hidden>
            <div class="trial-filter-options" data-filter-options><TagFilter tags={allTags} /></div>
            <button type="button" class="trial-filter-close line-action" aria-label="Close Tag filter"><span class="line-action__word">Close</span></button>
          </section>
          <DrawerTrigger class="trial-disclosure line-action" data-trial-panel="year" controls="trial-year"><span class="line-action__word">Year</span><span class="trial-filter-value" data-trial-filter-value aria-hidden="true" hidden></span></DrawerTrigger>
          <section id="trial-year" class="trial-drawer trial-filter" aria-label="Year filter" hidden>
            <div class="trial-filter-options" data-filter-options><YearFilter years={allYears} /></div>
            <button type="button" class="trial-filter-close line-action" aria-label="Close Year filter"><span class="line-action__word">Close</span></button>
          </section>
        </div>
        <div id="site-shell" class="min-h-screen flex flex-col items-center justify-center p-4">
          <header class="mb-12 text-center">
            <h1 class="text-4xl font-bold tracking-tighter uppercase mb-2">Talich Helfen</h1>
            <p class="text-zinc-500 font-mono text-sm">Composer / Arranger - Works Distribution Map</p>
          </header>
          <main class="w-full max-w-5xl">
            <div id="trial-ambient" aria-hidden="true"><canvas id="archive-galaxy"></canvas></div>
            <WorksMap externalAudioHud externalWorkPreview rebuildScope />
          </main>
          <Footer />
        </div>
        <PointPreview />
        <section id="trial-detail" class="trial-drawer" aria-label="Work details" hidden>
          <div class="trial-detail-head"><span id="trial-detail-meta"></span><button type="button" id="trial-detail-close" class="line-action" aria-label="Close work details"><span class="line-action__word">Close</span></button></div>
          <div id="trial-detail-thumbnail" hidden></div>
          <h2 id="trial-detail-title"></h2>
          <p id="trial-detail-tags"></p>
          <a id="trial-detail-link" class="line-action" target="_blank" rel="noopener noreferrer"><span class="line-action__word">Open work</span></a>
        </section>
        <ArchiveWheel entries={wheelEntries} centredTrial cleanTrial />
      </div>
    </div>
    <script>
      import { bootArchiveNavigation } from '../lib/archiveNavigationBrowser';
      import { archiveClock, bindArchiveStop } from '../lib/archiveClock';
      import { getYear } from '../lib/filterStore';
      bootArchiveNavigation();
      bindArchiveStop();

      const ambient = document.getElementById('trial-ambient');
      if (ambient) {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let appliedYear: number | null = null;
        let travel: Animation | undefined;
        function cancelTravel() {
          travel?.cancel();
          travel = undefined;
        }
        reducedMotion.addEventListener('change', ({ matches }) => {
          if (matches && !archiveClock.stopped) cancelTravel();
        });
        archiveClock.subscribe(stopped => {
          if (!stopped && reducedMotion.matches) cancelTravel();
        });
        window.addEventListener('work-filters-applied', () => {
          if (archiveClock.stopped) return;
          const previous = appliedYear;
          const value = getYear();
          const year = value ? Number(value) : NaN;
          appliedYear = Number.isFinite(year) ? year : null;
          if (appliedYear === previous) return; // Tag changes do not interrupt year travel.
          if (previous === null || appliedYear === null || reducedMotion.matches) {
            cancelTravel();
            return;
          }
          // On replacement, fade the current pose in place before starting from centre.
          const current = travel && getComputedStyle(ambient);
          const transform = current?.transform ?? 'none';
          const opacity = current?.opacity ?? '1';
          cancelTravel();
          const lead = transform !== 'none' || opacity !== '1' ? 180 : 0;
          const duration = lead + 1000;
          const frame = (ms: number, transform: string, opacity: number | string, easing = 'linear'): Keyframe =>
            ({ offset: ms / duration, transform, opacity, easing });
          const end = appliedYear < previous ? 'scale(0.84)' : 'scale(1.16)';
          const animation = ambient.animate([
            ...(lead ? [
              frame(0, transform, opacity),
              frame(80, transform, 0, 'steps(1, end)'),
              frame(100, 'none', 0),
            ] : []),
            frame(lead, 'none', 1),
            frame(lead + 600, end, 1),
            frame(lead + 760, end, 0, 'steps(1, end)'),
            frame(lead + 800, 'none', 0),
            frame(duration, 'none', 1),
          ], { duration, fill: 'none' });
          travel = animation;
          animation.onfinish = () => {
            if (travel === animation) travel = undefined;
          };
        });
      }
    </script>
  </body>
</html>
