---
import { works } from '../data/works';
import AudioHud from './audio/AudioHud.astro';
import TagFilter from './filters/TagFilter.astro';
import YearFilter from './filters/YearFilter.astro';
import ContactBar from './layout/ContactBar.astro';
import ArchiveWheel from './works/ArchiveWheel.astro';
import WorkNode from './works/WorkNode.astro';
import { getWorkId } from '../lib/workIds';
import '../styles/global.css';

const allTags = [...new Set(works.flatMap((work) => work.tags ?? []))].sort();
const allYears = [...new Set(works.map((work) => String(work.year)))].sort().reverse();
const wheelEntries = works.map((work, index) => ({
  id: getWorkId(work, index),
  work,
}));
---

<ContactBar />

<div class="max-w-4xl mx-auto pt-6 px-4 space-y-4">
  <TagFilter tags={allTags} />
  <YearFilter years={allYears} />
</div>

<div class="main-layout">
  <div class="relative aspect-square px-4">
    <div id="map-target" class="map-container w-full h-full bg-zinc-950/40 border border-zinc-800 overflow-hidden font-mono text-[10px]">
      <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle, #27272a 1px, transparent 1px); background-size: 20px 20px;"></div>

      <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-30">
        <div class="w-full h-[1px] bg-zinc-800"></div>
        <div class="absolute h-full w-[1px] bg-zinc-800"></div>
      </div>
      <div class="absolute top-4 left-1/2 -translate-x-1/2 text-zinc-700 tracking-widest uppercase text-[8px]">Maniac [+]</div>
      <div class="absolute bottom-4 left-1/2 -translate-x-1/2 text-zinc-700 tracking-widest uppercase text-[8px]">Popular [-]</div>
      <div class="absolute left-4 top-1/2 -translate-y-1/2 -rotate-90 text-zinc-700 tracking-widest uppercase text-[8px] origin-left">Electro [L]</div>
      <div class="absolute right-4 top-1/2 -translate-y-1/2 rotate-90 text-zinc-700 tracking-widest uppercase text-[8px] origin-right">Acoustic [R]</div>

      <div class="absolute inset-16 sm:inset-24">
        {works.map((work, index) => <WorkNode work={work} index={index} workId={getWorkId(work, index)} />)}
      </div>
    </div>
  </div>

  <AudioHud />
</div>

<ArchiveWheel entries={wheelEntries} />

<style>
  .main-layout {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: 20px;
    max-width: 1200px;
    margin: 20px auto;
    font-family: 'JetBrains Mono', monospace;
    opacity: 0;
    transition: opacity 1s ease 0.5s;
  }

  :global(body:not(.is-blurred)) .main-layout {
    opacity: 1;
  }

  .map-container {
    perspective: 1200px;
    transform-style: preserve-3d;
    position: relative;
    isolation: isolate;
  }

  @media (max-width: 760px) {
    .main-layout {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import {
    getMeterLevel,
    setDelay,
    setDistortion,
    setReverb,
    setSpeed,
    setVolume,
    startAudio,
    togglePlayback,
  } from '../lib/audio/audioEngine';
  import { applyWorkFilters, setTag, setYear } from '../lib/filterStore';
  import { subscribe } from '../lib/workSelectionStore';
  import { setPlaybackRate, startVisualShift } from './effects/VisualShift';

  let isStarted = false;
  let meterFrame = 0;

  function updateMeter() {
    const vBar = document.getElementById('v-bar');
    if (vBar) {
      vBar.style.width = `${(getMeterLevel() * 100).toFixed(1)}%`;
    }
    meterFrame = requestAnimationFrame(updateMeter);
  }

  async function startExperience() {
    if (isStarted) return;
    isStarted = true;

    document.getElementById('start-overlay')?.classList.add('hidden');
    document.body.classList.remove('is-blurred');
    document.body.style.overflow = 'auto';
    const shell = document.getElementById('site-shell');
    shell?.style.setProperty('transition', 'none');
    shell?.style.setProperty('filter', 'none');
    const mainLayout = document.querySelector<HTMLElement>('.main-layout');
    mainLayout?.style.setProperty('transition', 'none');
    mainLayout?.style.setProperty('opacity', '1');

    startVisualShift();

    try {
      await startAudio();
      updateMeter();
    } catch (error) {
      console.error(error);
    }
  }

  function bindContactCopy() {
    document.querySelectorAll<HTMLElement>('[data-contact-copy]').forEach((button) => {
      button.addEventListener('click', () => {
        const text = button.dataset.contactCopy;
        if (!text) return;

        navigator.clipboard.writeText(text).then(() => {
          const toast = document.getElementById('copy-toast');
          toast?.classList.add('is-visible');
          setTimeout(() => toast?.classList.remove('is-visible'), 2000);
        });
      });
    });
  }

  function bindFilters() {
    document.querySelectorAll<HTMLButtonElement>('[data-filter-tag]').forEach((button) => {
      button.addEventListener('click', () => {
        startExperience();
        const value = button.dataset.filterTag;
        setTag(value && value !== '__all__' ? value : null);
        applyWorkFilters();
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-filter-year]').forEach((button) => {
      button.addEventListener('click', () => {
        startExperience();
        const value = button.dataset.filterYear;
        setYear(value && value !== '__all__' ? value : null);
        applyWorkFilters();
      });
    });
  }

  function bindWorkSelection() {
    const workNodes = Array.from(document.querySelectorAll<HTMLElement>('[data-work][data-work-id]'));
    subscribe((selectedId) => {
      workNodes.forEach((node) => {
        node.classList.toggle('is-selected', Boolean(selectedId && node.dataset.workId === selectedId));
      });
    });
  }

  function bindAudioControls() {
    const playPauseButton = document.getElementById('play-pause-btn');
    playPauseButton?.addEventListener('click', async () => {
      const playing = await togglePlayback();
      playPauseButton.innerText = playing ? 'Pause Transmission' : 'Resume Transmission';
    });

    document.querySelectorAll('.work-trigger').forEach((trigger) => {
      trigger.addEventListener('click', async () => {
        const playing = await togglePlayback();
        if (playPauseButton) {
          playPauseButton.innerText = playing ? 'Pause Transmission' : 'Resume Transmission';
        }
      });
    });

    document.getElementById('vol-fader')?.addEventListener('input', (event) => {
      setVolume(Number((event.target as HTMLInputElement).value));
    });
    document.getElementById('speed-fader')?.addEventListener('input', (event) => {
      const value = Number((event.target as HTMLInputElement).value);
      setSpeed(value);
      setPlaybackRate(value);
    });
    document.getElementById('dist-fader')?.addEventListener('input', (event) => {
      setDistortion(Number((event.target as HTMLInputElement).value));
    });
    document.getElementById('delay-fader')?.addEventListener('input', (event) => {
      setDelay(Number((event.target as HTMLInputElement).value));
    });
    document.getElementById('reverb-fader')?.addEventListener('input', (event) => {
      setReverb(Number((event.target as HTMLInputElement).value));
    });
  }

  function initWorksMap() {
    bindContactCopy();
    bindFilters();
    bindWorkSelection();
    bindAudioControls();
    applyWorkFilters();
    document.getElementById('start-overlay')?.addEventListener('click', startExperience);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWorksMap, { once: true });
  } else {
    initWorksMap();
  }

  window.addEventListener('beforeunload', () => cancelAnimationFrame(meterFrame));
</script>
