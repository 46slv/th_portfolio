<div class="control-group">
  <div class="control-reading"><label class="control-label" for="vol-fader">Master Gain</label><output for="vol-fader">0.50</output></div>
  <input type="range" id="vol-fader" min="0" max="1" step="0.01" value="0.5" />
</div>
<div class="control-group">
  <div class="control-reading"><label class="control-label" for="speed-fader">Relativistic Shift</label><output for="speed-fader">1.00</output></div>
  <input type="range" id="speed-fader" min="0" max="2" step="0.01" value="1.0" />
</div>
<div class="hud-divider"></div>
<div class="control-group">
  <div class="control-reading"><label class="control-label" for="dist-fader">Distortion (Entropy)</label><output for="dist-fader">0</output></div>
  <input type="range" id="dist-fader" min="0" max="100" step="1" value="0" />
</div>
<div class="control-group">
  <div class="control-reading"><label class="control-label" for="delay-fader">Delay (Echoes)</label><output for="delay-fader">0.00</output></div>
  <input type="range" id="delay-fader" min="0" max="0.8" step="0.01" value="0" />
</div>
<div class="control-group">
  <div class="control-reading"><label class="control-label" for="reverb-fader">Reverb (Space)</label><output for="reverb-fader">0.00</output></div>
  <input type="range" id="reverb-fader" min="0" max="1" step="0.01" value="0" />
</div>

<style>
  .control-reading { display:contents; }
  :global(body.archive-rebuild) .control-reading { display:flex; justify-content:space-between; gap:12px; align-items:baseline; }
  output { display:none; }
  :global(body.archive-rebuild) output { display:inline; color:#e4faff; font:10px/1 monospace; font-variant-numeric:tabular-nums; }
  .control-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .control-label {
    font-size: 8px;
    color: #22d3ee;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    opacity: 0.8;
  }

  input[type="range"] {
    appearance: none;
    background: #18181b;
    height: 2px;
    outline: none;
    width: 100%;
  }

  input[type="range"]::-webkit-slider-thumb {
    appearance: none;
    width: 8px;
    height: 8px;
    background: #22d3ee;
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 0 5px #22d3ee;
  }

  .hud-divider {
    height: 1px;
    background: rgba(34, 211, 238, 0.05);
    margin: 10px 0;
  }
</style>

<script>
  // Native range input remains the only control; the reading follows its live value.
  if (document.body.classList.contains('archive-rebuild')) {
    document.querySelectorAll<HTMLInputElement>('#trial-audio input[type="range"]').forEach(input => {
      const reading = input.parentElement?.querySelector<HTMLOutputElement>('output');
      const update = () => { if (reading) reading.value = Number(input.value).toFixed(input.step === '1' ? 0 : 2); };
      input.addEventListener('input', update);
      update();
    });
  }
</script>
