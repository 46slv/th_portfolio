<div class="control-group">
  <label class="control-label" for="vol-fader">Master Gain</label>
  <input type="range" id="vol-fader" min="0" max="1" step="0.01" value="0.5" />
</div>
<div class="control-group">
  <label class="control-label" for="speed-fader">Relativistic Shift</label>
  <input type="range" id="speed-fader" min="0" max="2" step="0.01" value="1.0" />
</div>
<div class="hud-divider"></div>
<div class="control-group">
  <label class="control-label" for="dist-fader">Distortion (Entropy)</label>
  <input type="range" id="dist-fader" min="0" max="100" step="1" value="0" />
</div>
<div class="control-group">
  <label class="control-label" for="delay-fader">Delay (Echoes)</label>
  <input type="range" id="delay-fader" min="0" max="0.8" step="0.01" value="0" />
</div>
<div class="control-group">
  <label class="control-label" for="reverb-fader">Reverb (Space)</label>
  <input type="range" id="reverb-fader" min="0" max="1" step="0.01" value="0" />
</div>

<style>
  .control-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .control-label {
    font-size: 8px;
    color: #22d3ee;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    opacity: 0.8;
  }

  input[type="range"] {
    appearance: none;
    background: #18181b;
    height: 2px;
    outline: none;
    width: 100%;
  }

  input[type="range"]::-webkit-slider-thumb {
    appearance: none;
    width: 8px;
    height: 8px;
    background: #22d3ee;
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 0 5px #22d3ee;
  }

  .hud-divider {
    height: 1px;
    background: rgba(34, 211, 238, 0.05);
    margin: 10px 0;
  }
</style>
