---
import type { Work } from '../../types/work';

interface Props {
  work: Work;
  index: number;
  workId: string;
}

const { work, index, workId } = Astro.props;
const left = ((work.x + 100) / 200) * 100;
const bottom = ((work.y + 100) / 200) * 100;
const ytId = work.url?.match(/(?:youtu\.be\/|youtube\.com\/watch\?v=)([^#&?]*)/)?.[1];
const thumbnailUrl = ytId ? `https://img.youtube.com/vi/${ytId}/mqdefault.jpg` : '';
const floatDelay = -(((index * 37) % 60) / 10);
---

<div
  data-work
  data-work-id={workId}
  data-tags={work.tags?.join(",") ?? ""}
  data-year={work.year}
  data-tooltip-title={work.title || 'Untitled'}
  data-tooltip-artist={work.artist || 'Unknown'}
  data-tooltip-tags={work.tags?.join(' | ') ?? ''}
  data-tooltip-thumbnail={thumbnailUrl}
  class="group absolute cursor-crosshair"
  style={`left: ${left}%; bottom: ${bottom}%; z-index: ${Math.round(bottom)};`}
>
  <a
    href={work.url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${work.title || 'Untitled'} / ${work.artist || 'Unknown'} / ${work.year}`}
    aria-describedby="work-tooltip"
    data-point-float
    class="relative w-4 h-4 flex items-center justify-center work-trigger point-float"
    style={`animation-delay: ${floatDelay}s;`}
  >
    <div class="absolute w-full h-[1px] bg-zinc-600 group-hover:bg-cyan-400"></div>
    <div class="absolute h-full w-[1px] bg-zinc-600 group-hover:bg-cyan-400"></div>
    <div class="w-1 h-1 bg-white"></div>
  </a>
</div>

<style>
  @keyframes point-float {
    0%,
    100% {
      transform: translate3d(0, 0, 0) rotate(0deg);
    }
    33% {
      transform: translate3d(4px, -6px, 0) rotate(1deg);
    }
    66% {
      transform: translate3d(-3px, -2px, 0) rotate(-1deg);
    }
  }

  [data-work] {
    position: absolute;
    transition:
      opacity 0.22s ease,
      transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    transform: translate(-50%, 50%);
  }

  [data-work]:hover,
  [data-work]:focus-within {
    z-index: 90;
    transform: translate(-50%, 50%) scale(1.08);
  }

  [data-work].is-active {
    opacity: 1;
    z-index: 100;
    transform: translate(-50%, 50%) scale(1.12);
  }

  [data-work].is-selected {
    opacity: 1;
    z-index: 120;
    transform: translate(-50%, 50%) scale(1.18);
  }

  [data-work].is-inactive {
    opacity: 0.1;
    z-index: 0;
    transform: translate(-50%, 50%) translateZ(-300px) scale(0.7);
    pointer-events: none;
  }

  .point-float {
    animation: point-float 6s ease-in-out infinite;
  }

  .group:hover .point-float,
  .group:focus-within .point-float {
    animation-play-state: paused;
  }

</style>
