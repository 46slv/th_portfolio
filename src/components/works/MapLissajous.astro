---
const { rebuildScope = false } = Astro.props;
---

<canvas
  id="map-lissajous"
  class={rebuildScope ? 'rebuild-scope' : undefined}
  width="900"
  height="900"
  role="img"
  aria-label="Live stereo Lissajous audio scope"
></canvas>

<style>
  #map-lissajous {
    position: absolute;
    inset: 9%;
    z-index: 1;
    display: block;
    width: 82%;
    height: 82%;
    opacity: 0.72;
    pointer-events: none;
  }

  @media (max-width: 760px) {
    #map-lissajous {
      inset: 12%;
      width: 76%;
      height: 76%;
      opacity: 0.58;
    }
  }

  /* Overscan only the rebuild scope; the Graph itself stays clipped and square. */
  #map-lissajous.rebuild-scope {
    inset: auto;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(128%, calc(100vw - 4px));
    height: min(128%, calc(100dvh - 4px));
    z-index: 0;
  }
</style>
