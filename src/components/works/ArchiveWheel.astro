---
import type { Work } from '../../types/work';
import DrawerTrigger from '../ui/DrawerTrigger.astro';

interface WheelEntry {
  id: string;
  work: Work;
}

interface Props {
  entries: WheelEntry[];
  centredTrial?: boolean;
  cleanTrial?: boolean;
}

const { entries, centredTrial = false, cleanTrial = false } = Astro.props;
const trialTrack = 'M 100 2 A 98 98 0 0 0 100 198';
const trialTicks = Array.from({ length: 31 }, (_, i) => {
  const angle = (i - 15) * Math.PI / 30;
  const edge = Math.abs(i - 15) / 15;
  const length = i % 5 === 0 ? 6 : 3;
  return {
    x1: 100 - 98 * Math.cos(angle), y1: 100 + 98 * Math.sin(angle),
    x2: 100 - (98 - length) * Math.cos(angle), y2: 100 + (98 - length) * Math.sin(angle),
    opacity: .12 + (1 - edge) * .72, blur: edge * 1.2,
  };
});
---

<section id="archive-wheel" class="archive-wheel is-collapsed" aria-label="Works archive wheel" tabindex={cleanTrial ? -1 : 0} data-centred-trial={String(centredTrial)} data-clean-trial={String(cleanTrial)}>
  {centredTrial && <svg class="archive-wheel__trial-arc" viewBox="0 0 100 200" preserveAspectRatio={cleanTrial ? 'none' : undefined} aria-hidden="true">
    {cleanTrial && <path class="archive-wheel__arc-rim" d={trialTrack} fill="none" />}
    <path data-trial-track d={trialTrack} fill="none" stroke="transparent" stroke-width="10" />
    {trialTicks.map((tick) => <line x1={tick.x1} y1={tick.y1} x2={tick.x2} y2={tick.y2} opacity={tick.opacity}
      style={tick.blur > .1 ? ('filter:blur(' + tick.blur + 'px)') : undefined} />)}
  </svg>}
  <DrawerTrigger controls="archive-wheel-rail" class={cleanTrial ? 'archive-wheel__toggle line-action' : 'archive-wheel__toggle'} data-wheel-toggle aria-label="Toggle archive wheel">
    {cleanTrial ? <>
      <span class="archive-wheel__quiet-open line-action__word" aria-hidden="true"><span class="archive-wheel__arc-label">Wheel</span><span class="archive-wheel__portrait-label">Browse works</span></span>
      <span class="archive-wheel__quiet-close line-action__word" aria-hidden="true">Close</span>
    </> : <span class="archive-wheel__toggle-mark"></span>}
  </DrawerTrigger>
  <div class="archive-wheel__step-controls" data-wheel-step-controls aria-label="Archive wheel rotation controls">
    <button type="button" class={cleanTrial ? 'archive-wheel__step line-action' : 'archive-wheel__step'} data-wheel-step="-1" aria-label="Previous work">
      {cleanTrial ? <span class="line-action__word"><span class="archive-wheel__arc-label">Prev</span><span class="archive-wheel__portrait-label">Previous</span></span> : <span class="archive-wheel__step-mark archive-wheel__step-mark--up"></span>}
    </button>
    <button type="button" class={cleanTrial ? 'archive-wheel__step line-action' : 'archive-wheel__step'} data-wheel-step="1" aria-label="Next work">
      {cleanTrial ? <span class="line-action__word">Next</span> : <span class="archive-wheel__step-mark archive-wheel__step-mark--down"></span>}
    </button>
  </div>
  <div class="archive-wheel__rail" id="archive-wheel-rail" data-wheel-rail inert aria-hidden="true">
    {cleanTrial && <p data-wheel-empty hidden>No works match these filters.</p>}
    {entries.map(({ id, work }, index) => (
      <button
        type="button"
        class={cleanTrial ? 'archive-wheel__item line-action-wheel' : 'archive-wheel__item'}
        data-wheel-work
        data-work-id={id}
        data-wheel-index={index}
        aria-label={`${work.title} / ${work.artist}`}
      >
        <span class="archive-wheel__year">{work.year}</span>
        <span class={cleanTrial ? 'archive-wheel__title line-action' : 'archive-wheel__title'}>{cleanTrial ? <span class="line-action__word">{work.title || 'Untitled'}</span> : (work.title || 'Untitled')}</span>
        <span class="archive-wheel__artist">{work.artist || 'Unknown'}</span>
        {cleanTrial && <span class="archive-wheel__portrait-label archive-wheel__details" aria-hidden="true">Details</span>}
      </button>
    ))}
  </div>
</section>

<style>
  .archive-wheel {
    position: fixed;
    right: clamp(8px, 2vw, 18px);
    bottom: clamp(14px, 3vw, 30px);
    z-index: 60;
    width: min(390px, calc(100vw - 16px));
    height: min(410px, 46vh);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 18px 46px 18px 16px;
    background: transparent;
    opacity: 0;
    pointer-events: none;
    overflow: clip;
    contain: paint;
    isolation: isolate;
    transform: translateY(10px);
    transition:
      opacity 0.45s ease,
      transform 0.52s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .archive-wheel::before {
    content: "";
    position: absolute;
    right: -80px;
    top: 50%;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    transform: translateY(-50%);
    background:
      radial-gradient(circle, rgba(34, 211, 238, 0.18) 0 1px, transparent 2px),
      radial-gradient(circle at 50% 50%, rgba(34, 211, 238, 0.14), rgba(34, 211, 238, 0.04) 42%, transparent 68%);
    border: 1px solid rgba(34, 211, 238, 0.16);
    box-shadow:
      inset 0 0 32px rgba(34, 211, 238, 0.08),
      0 0 28px rgba(34, 211, 238, 0.06);
    pointer-events: none;
    transition: opacity 0.32s ease;
  }

  .archive-wheel::after {
    content: "";
    position: absolute;
    right: 44px;
    top: 50%;
    width: 1px;
    height: 66%;
    transform: translateY(-50%);
    background: linear-gradient(transparent, rgba(34, 211, 238, 0.36), transparent);
    pointer-events: none;
    transition: opacity 0.32s ease;
  }

  :global(body:not(.is-blurred)) .archive-wheel {
    opacity: 1;
    transform: translateY(0);
  }

  .archive-wheel.is-collapsed::before,
  .archive-wheel.is-collapsed::after {
    opacity: 0;
  }

  .archive-wheel:focus-visible {
    outline: 1px solid rgba(34, 211, 238, 0.7);
    outline-offset: 3px;
  }

  .archive-wheel__toggle {
    position: absolute;
    right: 0;
    top: 50%;
    z-index: 4;
    width: 34px;
    height: 76px;
    border: 1px solid rgba(34, 211, 238, 0.36);
    border-radius: 8px;
    background: rgba(2, 2, 5, 0.58);
    color: #22d3ee;
    cursor: pointer;
    pointer-events: auto;
    transform: translateY(-50%);
    transition:
      background 0.25s ease,
      border-color 0.25s ease;
  }

  .archive-wheel__toggle:hover {
    background: rgba(8, 47, 73, 0.42);
    border-color: rgba(34, 211, 238, 0.72);
  }

  .archive-wheel__toggle-mark {
    position: absolute;
    inset: 0;
  }

  .archive-wheel__toggle-mark::before,
  .archive-wheel__toggle-mark::after {
    content: "";
    position: absolute;
    left: 12px;
    width: 8px;
    height: 1px;
    background: currentColor;
    box-shadow: 0 0 8px currentColor;
    transform-origin: left center;
    transition: transform 0.25s ease;
  }

  .archive-wheel__toggle-mark::before {
    top: 35px;
    transform: rotate(36deg);
  }

  .archive-wheel__toggle-mark::after {
    top: 41px;
    transform: rotate(-36deg);
  }

  .archive-wheel.is-collapsed .archive-wheel__toggle-mark::before {
    transform: rotate(-36deg);
  }

  .archive-wheel.is-collapsed .archive-wheel__toggle-mark::after {
    transform: rotate(36deg);
  }

  .archive-wheel__step-controls {
    position: absolute;
    right: 0;
    top: 50%;
    z-index: 3;
    width: 34px;
    height: 34px;
    pointer-events: none;
    transform: translateY(-50%);
  }

  .archive-wheel.is-collapsed .archive-wheel__step-controls {
    pointer-events: none;
  }

  .archive-wheel__step {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 26px;
    height: 26px;
    border: 1px solid rgba(34, 211, 238, 0.28);
    border-radius: 6px;
    background: rgba(2, 2, 5, 0.54);
    color: #22d3ee;
    cursor: pointer;
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, -50%);
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      opacity 0.22s ease,
      transform 0.2s ease;
  }

  .archive-wheel__step[data-wheel-step="-1"] {
    transform: translate(-50%, -72px);
  }

  .archive-wheel__step[data-wheel-step="1"] {
    transform: translate(-50%, 46px);
  }

  .archive-wheel.is-collapsed .archive-wheel__step {
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .archive-wheel__step:hover {
    background: rgba(8, 47, 73, 0.38);
    border-color: rgba(34, 211, 238, 0.68);
  }

  .archive-wheel__step:active {
    opacity: 0.82;
  }

  .archive-wheel__step-mark {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 8px;
    border-left: 1px solid currentColor;
    border-top: 1px solid currentColor;
    box-shadow: -2px -2px 8px rgba(34, 211, 238, 0.26);
  }

  .archive-wheel__step-mark--up {
    transform: translate(-50%, -32%) rotate(45deg);
  }

  .archive-wheel__step-mark--down {
    transform: translate(-50%, -68%) rotate(225deg);
  }

  .archive-wheel__rail {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: auto;
    touch-action: pan-y;
    clip-path: inset(0 0 0 0);
    transform: translateX(0);
    transition:
      clip-path 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.32s ease,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .archive-wheel.is-collapsed .archive-wheel__rail {
    clip-path: inset(0 0 0 100%);
    opacity: 0;
    pointer-events: none;
    transform: translateX(24px);
  }

  .archive-wheel__item {
    position: absolute;
    top: 50%;
    right: 0;
    width: min(300px, calc(100vw - 70px));
    min-height: 46px;
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr);
    grid-template-areas:
      "year title"
      "year artist";
    column-gap: 10px;
    align-items: center;
    border: 0;
    border-right: 1px solid rgba(113, 113, 122, 0.42);
    background: transparent;
    color: #d4d4d8;
    font: inherit;
    font-family: 'JetBrains Mono', monospace;
    text-align: right;
    padding: 7px 12px 7px 4px;
    cursor: pointer;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform-origin: right center;
    transition:
      opacity 0.45s ease,
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.35s ease,
      border-color 0.35s ease;
  }

  .archive-wheel.is-dragging .archive-wheel__item {
    transition: none;
  }

  .archive-wheel__item.is-hidden {
    display: none;
  }

  .archive-wheel__item.is-selected {
    color: #ffffff;
    border-color: rgba(34, 211, 238, 0.92);
    text-shadow: 0 0 14px rgba(34, 211, 238, 0.54);
  }

  .archive-wheel__year {
    grid-area: year;
    color: #22d3ee;
    font-size: 8px;
    letter-spacing: 0.16em;
    opacity: 0.72;
  }

  .archive-wheel__title {
    grid-area: title;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 10px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .archive-wheel__artist {
    grid-area: artist;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #71717a;
    font-size: 8px;
    letter-spacing: 0.08em;
    line-height: 1.25;
  }

  @media (max-width: 760px) {
    .archive-wheel {
      right: 6px;
      bottom: 10px;
      width: min(340px, calc(100vw - 12px));
      height: 310px;
      padding: 14px 42px 14px 12px;
    }

    .archive-wheel::before {
      right: -72px;
      width: 250px;
      height: 250px;
    }

    .archive-wheel__item {
      width: min(270px, calc(100vw - 54px));
    }
  }

  /* Local candidate only. The regular route retains its existing interactions. */
  .archive-wheel[data-centred-trial="true"] {
    --trial-r: min(34vw, 36dvh, 310px);
    right: 0;
    top: var(--trial-graph-y, 50dvh);
    bottom: auto;
    width: var(--trial-r);
    height: calc(var(--trial-r) * 2);
    padding: 0;
    overflow: visible;
    contain: none;
    transform: translateY(-50%);
    transition: opacity .24s ease;
  }
  :global(body:not(.is-blurred)) .archive-wheel[data-centred-trial="true"] { transform: translateY(-50%); }
  .archive-wheel[data-centred-trial="true"]::before,
  .archive-wheel[data-centred-trial="true"]::after { display: none; }
  /* Only the open rebuild: a non-interactive, ellipse-sized material behind
     the rail. The mask reaches zero at the same right-centred ellipse used
     by insideOpenDisc; no edge stroke, hover response or new hit surface. */
  .archive-wheel[data-centred-trial="true"][data-clean-trial="true"]:not(.is-collapsed)::before {
    display:block; inset:0; width:100%; height:100%; border:0; border-radius:0;
    transform:none; box-shadow:none; z-index:-1; pointer-events:none;
    background:radial-gradient(ellipse 100% 50% at 100% 50%,
      rgba(226,235,237,.01375) 0%, rgba(226,235,237,.01) 70%, transparent 100%);
    transition:none;
  }
  @supports ((backdrop-filter:blur(4px)) and (mask-image:radial-gradient(ellipse, black, transparent))) {
    .archive-wheel[data-centred-trial="true"][data-clean-trial="true"]:not(.is-collapsed)::before {
      background:rgba(226,235,237,.01125);
      backdrop-filter:blur(4px);
      -webkit-backdrop-filter:blur(4px);
      -webkit-mask-image:radial-gradient(ellipse 100% 50% at 100% 50%, black 0%, black 70%, transparent 100%);
      mask-image:radial-gradient(ellipse 100% 50% at 100% 50%, black 0%, black 70%, transparent 100%);
    }
  }
  .archive-wheel__trial-arc { position:absolute; inset:0; width:100%; height:100%; overflow:visible; pointer-events:none; }
  .archive-wheel__trial-arc line { stroke:#c2cbcf; stroke-width:1; vector-effect:non-scaling-stroke; }
  .archive-wheel__arc-rim { display:none; }
  .archive-wheel[data-clean-trial="true"]:not(.is-collapsed) .archive-wheel__trial-arc line { display:none; }
  .archive-wheel__trial-arc [data-trial-track] { pointer-events:stroke; touch-action:none; cursor:grab; }
  .archive-wheel.is-collapsed .archive-wheel__trial-arc {
    transform:scale(.19); transform-origin:right center;
  }
  .archive-wheel.is-collapsed [data-trial-track] { pointer-events:none; }
  .archive-wheel__trial-arc { transition:transform .32s cubic-bezier(.22,1,.36,1); transform-origin:right center; }
  .archive-wheel[data-centred-trial="true"] .archive-wheel__rail {
    position:absolute; inset:0; overflow:visible; pointer-events:none; clip-path:none; transform:none;
  }
  .archive-wheel[data-centred-trial="true"] .archive-wheel__item {
    right:auto; left:100%; top:50%; width:min(164px,43vw); min-height:32px;
    grid-template-columns:30px minmax(0,1fr); padding:4px 8px 4px 4px;
    text-align:left; transform-origin:left center; border:0; border-left:1px solid rgba(113,113,122,.38);
    background: linear-gradient(90deg,rgba(8,13,15,.62),transparent);
  }
  .archive-wheel[data-centred-trial="true"] .archive-wheel__item.is-selected { border-color:#67e8ff; }
  .archive-wheel[data-centred-trial="true"] .archive-wheel__toggle {
    right:8px; width:44px; height:48px; background:transparent; border:0; border-radius:0;
  }
  .archive-wheel[data-centred-trial="true"].is-collapsed .archive-wheel__toggle { right:calc(var(--trial-r) * .19 - 22px); height:54px; width:48px; }
  .archive-wheel[data-centred-trial="true"].is-collapsed .archive-wheel__toggle-mark { opacity:0; }
  .archive-wheel[data-centred-trial="true"] .archive-wheel__step { min-width:34px; min-height:34px; }
  .archive-wheel[data-centred-trial="true"].is-collapsed .archive-wheel__step { visibility:hidden; }
  .archive-wheel[data-centred-trial="true"] .archive-wheel__step-controls { right:8px; }
  @media(max-width:760px) {
    .archive-wheel[data-centred-trial="true"] { --trial-r:min(46vw,31dvh,215px); }
    .archive-wheel[data-centred-trial="true"] .archive-wheel__item { width:min(126px,43vw); grid-template-columns:26px minmax(0,1fr); }
    .archive-wheel[data-centred-trial="true"] .archive-wheel__title { font-size:9px; }
  }
  @media(prefers-reduced-motion:reduce) {
    .archive-wheel[data-centred-trial="true"], .archive-wheel[data-centred-trial="true"] * { transition:none!important; }
  }

  /* SVG paths have no CSS layout box: apply touch-action to the SVG viewport
     so the browser does not cancel a track swipe to begin page panning. */
  .archive-wheel[data-clean-trial="true"] .archive-wheel__trial-arc { touch-action:none; }
  .archive-wheel[data-clean-trial="true"] .archive-wheel__item {
    /* The render offset owns position and opacity; don't re-interpolate each label. */
    transition: color .35s ease, border-color .35s ease;
    background:none; border-color:transparent;
  }
  .archive-wheel[data-clean-trial="true"]:not(.is-collapsed) .archive-wheel__item { border:0; }
  /* Rebuild reading hierarchy: the centre is readable, adjacent stations stay
     quieter through the existing distance opacity rather than tiny type. */
  .archive-wheel[data-clean-trial="true"] .archive-wheel__title { overflow:visible; font-size:12px; }
  .archive-wheel[data-clean-trial="true"] .archive-wheel__item.is-selected .archive-wheel__title { font-size:14px; }
  .archive-wheel[data-clean-trial="true"] .archive-wheel__year {
    font-size:11px; letter-spacing:.02em; opacity:1; color:#9be5ef;
  }
  .archive-wheel[data-clean-trial="true"] .archive-wheel__artist {
    font-size:11px; letter-spacing:0; color:#aebdc2;
  }
  .archive-wheel[data-clean-trial="true"] .archive-wheel__title .line-action__word {
    max-width:100%; overflow:hidden; text-overflow:ellipsis;
  }
  .archive-wheel[data-clean-trial="true"] .archive-wheel__item.is-selected {
    border-color:rgba(103,232,255,.6); text-shadow:none;
  }
  .archive-wheel[data-clean-trial="true"]:focus-visible { outline:none; }
  .archive-wheel[data-clean-trial="true"]:focus-visible .archive-wheel__item.is-selected,
  .archive-wheel[data-clean-trial="true"] .archive-wheel__item:focus-visible {
    outline:1px solid rgba(103,232,255,.55); outline-offset:1px;
  }
  .archive-wheel[data-clean-trial="true"] .archive-wheel__step-controls { right:26px; }
  .archive-wheel[data-clean-trial="true"] .archive-wheel__step {
    opacity:0; pointer-events:none; background:transparent; border:none; border-radius:0;
    width:74px; min-height:44px; justify-content:center;
  }
  .archive-wheel[data-clean-trial="true"] .archive-wheel__step:focus-visible {
    opacity:1; pointer-events:auto;
  }
  .archive-wheel[data-centred-trial="true"][data-clean-trial="true"] .archive-wheel__toggle {
    right:8px; width:80px; height:44px; border:none; border-radius:0; background:none;
  }
  .archive-wheel[data-centred-trial="true"][data-clean-trial="true"].is-collapsed .archive-wheel__toggle {
    right:4px; width:84px; height:44px;
    border:0; border-radius:0; background:transparent;
  }
  .archive-wheel[data-clean-trial="true"] .archive-wheel__toggle:focus-visible { outline:none; }
  .archive-wheel[data-clean-trial="true"] .archive-wheel__toggle:focus-visible .archive-wheel__quiet-close {
    color:#dcf6fb; text-decoration:underline; text-underline-offset:4px;
  }
  @media(max-width:760px){
    /* Keep the browsing arc outside the narrow Graph's Point cluster. Labels
       use the radius, not a fixed-width box projecting back into the Graph. */
    .archive-wheel[data-centred-trial="true"][data-clean-trial="true"] { --trial-r:min(22vw,29dvh,96px); }
    .archive-wheel[data-clean-trial="true"] .archive-wheel__item {
      width:calc(var(--trial-r) - 8px); padding:4px;
      grid-template-columns:minmax(0,1fr); column-gap:0;
      grid-template-areas:"title" "year";
    }
    .archive-wheel[data-clean-trial="true"] .archive-wheel__artist { display:none; }
    .archive-wheel[data-clean-trial="true"] .archive-wheel__year { font-size:11px; letter-spacing:0; }
    .archive-wheel[data-clean-trial="true"] .archive-wheel__title { font-size:11px; }
    .archive-wheel[data-clean-trial="true"] .archive-wheel__item.is-selected .archive-wheel__title { font-size:13px; }
    .archive-wheel[data-centred-trial="true"][data-clean-trial="true"]:not(.is-collapsed) .archive-wheel__toggle {
      top:-24px;
    }
    .archive-wheel[data-centred-trial="true"][data-clean-trial="true"] [data-trial-track] {
      stroke-width:24px; vector-effect:non-scaling-stroke;
    }
  }
  @media(max-height:480px) {
    /* A short landscape has a small arc despite desktop width. The toggle
       otherwise sits on the centre title and steals its real click. */
    .archive-wheel[data-centred-trial="true"][data-clean-trial="true"] .archive-wheel__item {
      width:min(126px,calc(var(--trial-r) - 8px));
    }
    .archive-wheel[data-centred-trial="true"][data-clean-trial="true"]:not(.is-collapsed) .archive-wheel__toggle { top:-24px; }
  }
  .archive-wheel__quiet-close { font:11px/1 monospace; color:#c8d2d6; display:inline-block; }
  .archive-wheel__quiet-open, .archive-wheel__portrait-label { display:none; }
  .archive-wheel.is-collapsed .archive-wheel__quiet-open { display:inline-block; color:#edfaff; font:11px monospace; }
  .archive-wheel.is-collapsed .archive-wheel__quiet-close { display:none; }
  .archive-wheel[data-clean-trial="true"] [data-trial-track] { stroke-width:22; }
  .archive-wheel[data-clean-trial="true"].is-collapsed [data-trial-track] { pointer-events:none; }
</style>

<script>
  import { getSelectedWork, setSelectedWork, subscribe } from '../../lib/workSelectionStore';
  import { dispatchArchiveFilter, dispatchArchiveSelection, isArchiveWheelCommit } from '../../lib/archiveSelectionBrowser';
  import { lightGestureGap, ownWheel, movedFromWheel, decideDirectWheel, decideDocumentWheel, insideWheelViewport, insideOpenDisc, resolveMeasuredWheel } from '../../lib/archiveWheelInput';
  import type { WheelHit } from '../../lib/archiveWheelInput';
  import { clampVelocity, projectCoast, advanceCoast } from '../../lib/archiveWheelCoast';
  import { wheelDeltaPixels } from '../../lib/archiveWheelDelta';
  import { estimateWheelSpeed } from '../../lib/archiveWheelSpeed';
  import { archivePortraitMedia } from '../../lib/archivePortrait';
  import { circularStationPose, stationEmphasis } from './wheelGeometry';

  const wheel = document.getElementById('archive-wheel');
  const rail = wheel?.querySelector<HTMLElement>('[data-wheel-rail]');
  const toggle = wheel?.querySelector<HTMLButtonElement>('[data-wheel-toggle]');
