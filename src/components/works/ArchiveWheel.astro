    }

    renderedItems.forEach((item) => {
      if (!nextRenderedItems.has(item)) hideStation(item);
    });
    renderedItems = nextRenderedItems;
    if (hadItemFocus && (readingDock ? focusedItem !== list[centerIndex] : rebuild && focusedItem.tabIndex < 0)) {
      list[centerIndex]?.focus({ preventScroll: true });
    }
  }

  function hideStation(item: HTMLElement) {
    item.classList.remove('is-selected');
    item.removeAttribute('aria-current');
    item.style.visibility = 'hidden';
    item.style.opacity = '0';
    item.style.pointerEvents = 'none';
    if (cleanTrial) item.tabIndex = -1;
  }

  wheel?.addEventListener('wheel', (event) => {
    if (blocked()) return;
    if (cleanTrial) {
      const collapsed = wheel.classList.contains('is-collapsed');
      const target = event.target as Element;
      const controlHit = !collapsed && !event.ctrlKey && Boolean(target.closest('[data-wheel-toggle],[data-wheel-step]'));
      const decision = decideDirectWheel({
        collapsed, ctrlKey: event.ctrlKey, controlHit,
        directHit: !collapsed && !event.ctrlKey && !controlHit && Boolean(target.closest('[data-trial-track],[data-wheel-work]')),
        x: event.clientX, y: event.clientY, at: nowMs(), lastHit: lastWheelHit,
      });
      if (decision === 'clear') clearWheelOwnership();
      if (decision !== 'consume') return; // document fallback receives unconsumed packets
      ownWheelAt(event.clientX, event.clientY);
    }
    event.preventDefault();
    rotateByPixels(wheelDeltaPixels(event, window));
  }, { passive: false });

  wheel?.addEventListener('keydown', (event) => {
    if (blocked() || (cleanTrial && wheel.classList.contains('is-collapsed'))) return;
    if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
      event.preventDefault();
      if (cleanTrial) cancelWheelMotion();
      selectVisibleIndex(selectedIndex + 1);
    }
    if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
      event.preventDefault();
      if (cleanTrial) cancelWheelMotion();
      selectVisibleIndex(selectedIndex - 1);
    }
  });

  wheel?.addEventListener('pointerdown', (event) => {
    if (blocked()) return;
    const target = event.target as Element;
    if (target.closest('[data-wheel-toggle],[data-wheel-step]')) return;
    if (portrait?.matches) {
      if (!event.isPrimary || event.button !== 0 || !target.closest('[data-wheel-work]')) return;
    } else if (centredTrial && !target.closest('[data-trial-track]')) return;
    setCollapsed(false);
    if (cleanTrial) cancelWheelMotion();
    else clearSettleTimer();
    wheelScrollIntent = null;
    rotating = true;
    dragging = true;
    dragPointer = event.pointerId;
    dragStartAxis = dragLastAxis = dragCoordinate(event);
    dragSamples = [{ at: nowMs(), offset: wheelOffset }];
    suppressDragClick = false;
    dragEndClick = null;
    dragStartOffset = wheelOffset;
    // Preserve an ordinary tap on the title. Capture only a real dock swipe.
    if (!portrait?.matches) {
      wheel.classList.add('is-dragging');
      wheel.setPointerCapture(event.pointerId);
    }
  });

  if (cleanTrial) document.addEventListener('pointermove', (event) => {
    if (movedFromWheel(lastWheelHit, { x: event.clientX, y: event.clientY })) clearWheelOwnership();
  }, { passive:true });
  wheel?.addEventListener('pointermove', (event) => {
    if (!dragging || (cleanTrial && event.pointerId !== dragPointer)) return;
    if (cleanTrial) {
      const axis = dragCoordinate(event);
      const moved = Math.abs(axis - dragStartAxis) > 8;
      if (portrait?.matches && !suppressDragClick) {
        if (!moved) return;
        wheel.setPointerCapture(event.pointerId);
        wheel.classList.add('is-dragging');
      }
      const change = Math.max(-180, Math.min(180, axis - dragLastAxis));
      dragLastAxis = axis;
      wheelOffset = clampOffset(wheelOffset - change / dragStepDistance);
      suppressDragClick ||= moved;
      const at = nowMs();
      dragSamples.push({ at, offset: wheelOffset });
      dragSamples = dragSamples.filter(s => at - s.at <= 125);
      publishRenderedStation();
    } else {
      const delta = (event.clientY - dragStartAxis) / dragStepDistance;
      setWheelOffset(dragStartOffset - delta);
    }
  });

  function endDrag(event: PointerEvent, canceled: boolean) {
    if (!dragging || (cleanTrial && event.pointerId !== dragPointer)) return;
    dragging = false;
    dragPointer = null;
    if (suppressDragClick) dragEndClick = { x: event.clientX, y: event.clientY, at: nowMs() };
    wheel?.classList.remove('is-dragging');
    if (wheel?.hasPointerCapture(event.pointerId)) wheel.releasePointerCapture(event.pointerId);
    if (cleanTrial) {
      const speed = canceled ? 0 : quietVelocity(dragSamples, nowMs());
      dragSamples = [];
      if (portrait?.matches && !suppressDragClick) { rotating = false; return; }
      if (!canceled && !reducedMotion?.matches) startCoast(speed);
      else snapToNearest();
    } else snapToNearest();
  }
  wheel?.addEventListener('pointerup', (event) => endDrag(event, false));
  wheel?.addEventListener('pointercancel', (event) => endDrag(event, true));
  wheel?.addEventListener('lostpointercapture', (event) => {
    if (!portrait?.matches || event.target === wheel) endDrag(event, true);
  });
  wheel?.addEventListener('pointerleave', (event) => {
    if (portrait?.matches && !wheel.hasPointerCapture(event.pointerId)) endDrag(event, true);
  });
  wheel?.addEventListener('click', (event) => {
    if (!cleanTrial || !suppressDragClick || !dragEndClick) return;
    if (nowMs() - dragEndClick.at > 320) { suppressDragClick = false; return; }
    if (event.detail === 0 || Math.hypot(event.clientX - dragEndClick.x, event.clientY - dragEndClick.y) > 12) return;
    suppressDragClick = false;
    event.preventDefault();
    event.stopPropagation();
  }, true);

  items.forEach((item) => {
    item.addEventListener('click', () => {
      if (blocked()) return;
      if (!item.classList.contains('is-hidden')) {
        setCollapsed(false);
        if (cleanTrial) cancelWheelMotion();
        if (cleanTrial) {
          dispatchArchiveSelection({ kind: 'wheel-title', workId: item.dataset.workId ?? null });
          layoutWheel();
        } else setSelectedWork(item.dataset.workId ?? null);
      }
    });
  });

  toggle?.addEventListener('click', () => {
    if (blocked()) return;
    setCollapsed(!wheel?.classList.contains('is-collapsed'));
  });

  stepButtons.forEach((button) => {
    button.addEventListener('click', () => {
      if (blocked()) return;
      const direction = Number(button.dataset.wheelStep);
      if (!direction) return;
      if (cleanTrial) cancelWheelMotion();
      else clearSettleTimer();
      rotating = false;
      selectVisibleIndex(selectedIndex + direction);
    });
  });

  if (centredTrial) {
    document.addEventListener('keydown', (event) => {
      if (!blocked() && event.key === 'Escape' && !wheel?.classList.contains('is-collapsed')) {
        if (cleanTrial && document.body.classList.contains('trial-has-drawer')) return;
        setCollapsed(true);
        toggle?.focus({ preventScroll: true });
      }
    });
    document.addEventListener('click', (event) => {
      const target = event.target as Element;
      if (blocked() || target.closest('#archive-wheel,[data-work],[data-archive-stop]')) return;
      if (cleanTrial && target.closest('.trial-drawer,#archive-trial-controls')) return;
      if (rebuild && target.closest('#point-preview')) return;
      if (!wheel?.classList.contains('is-collapsed')) setCollapsed(true);
    });
  }
  subscribe((id) => {
    if (cleanTrial && !isArchiveWheelCommit()) {
      cancelWheelMotion();
      const index = visibleItems().findIndex(item => item.dataset.workId === id);
      if (index >= 0) {
        selectedIndex = index;
        wheelOffset = index;
      }
    }
    layoutWheel();
  });
  window.addEventListener('work-filters-applied', syncFilteredItems);
  reducedMotion?.addEventListener('change', () => {
    if (reducedMotion.matches && (scrollTarget !== null || dragging)) {
      cancelWheelMotion();
      selectVisibleIndex(nearestIndex());
    }
  });
  window.addEventListener('beforeunload', cancelWheelMotion);
  syncFilteredItems();
</script>
