---
import type { Work } from '../../types/work';

interface WheelEntry {
  id: string;
  work: Work;
}

interface Props {
  entries: WheelEntry[];
}

const { entries } = Astro.props;
---

<section id="archive-wheel" class="archive-wheel is-collapsed" aria-label="Works archive wheel" tabindex="0">
  <button
    type="button"
    class="archive-wheel__toggle"
    data-wheel-toggle
    aria-label="Toggle archive wheel"
    aria-expanded="false"
  >
    <span class="archive-wheel__toggle-mark"></span>
  </button>
  <div class="archive-wheel__step-controls" data-wheel-step-controls aria-label="Archive wheel rotation controls">
    <button type="button" class="archive-wheel__step" data-wheel-step="-1" aria-label="Previous work">
      <span class="archive-wheel__step-mark archive-wheel__step-mark--up"></span>
    </button>
    <button type="button" class="archive-wheel__step" data-wheel-step="1" aria-label="Next work">
      <span class="archive-wheel__step-mark archive-wheel__step-mark--down"></span>
    </button>
  </div>
  <div class="archive-wheel__rail" data-wheel-rail inert aria-hidden="true">
    {entries.map(({ id, work }, index) => (
      <button
        type="button"
        class="archive-wheel__item"
        data-wheel-work
        data-work-id={id}
        data-wheel-index={index}
        aria-label={`${work.title} / ${work.artist}`}
      >
        <span class="archive-wheel__year">{work.year}</span>
        <span class="archive-wheel__title">{work.title || 'Untitled'}</span>
        <span class="archive-wheel__artist">{work.artist || 'Unknown'}</span>
      </button>
    ))}
  </div>
</section>

<style>
  .archive-wheel {
    position: fixed;
    right: clamp(8px, 2vw, 18px);
    bottom: clamp(14px, 3vw, 30px);
    z-index: 60;
    width: min(390px, calc(100vw - 16px));
    height: min(410px, 46vh);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 18px 46px 18px 16px;
    background: transparent;
    opacity: 0;
    pointer-events: none;
    overflow: clip;
    contain: paint;
    isolation: isolate;
    transform: translateY(10px);
    transition:
      opacity 0.45s ease,
      transform 0.52s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .archive-wheel::before {
    content: "";
    position: absolute;
    right: -80px;
    top: 50%;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    transform: translateY(-50%);
    background:
      radial-gradient(circle, rgba(34, 211, 238, 0.18) 0 1px, transparent 2px),
      radial-gradient(circle at 50% 50%, rgba(34, 211, 238, 0.14), rgba(34, 211, 238, 0.04) 42%, transparent 68%);
    border: 1px solid rgba(34, 211, 238, 0.16);
    box-shadow:
      inset 0 0 32px rgba(34, 211, 238, 0.08),
      0 0 28px rgba(34, 211, 238, 0.06);
    pointer-events: none;
    transition: opacity 0.32s ease;
  }

  .archive-wheel::after {
    content: "";
    position: absolute;
    right: 44px;
    top: 50%;
    width: 1px;
    height: 66%;
    transform: translateY(-50%);
    background: linear-gradient(transparent, rgba(34, 211, 238, 0.36), transparent);
    pointer-events: none;
    transition: opacity 0.32s ease;
  }

  :global(body:not(.is-blurred)) .archive-wheel {
    opacity: 1;
    transform: translateY(0);
  }

  .archive-wheel.is-collapsed::before,
  .archive-wheel.is-collapsed::after {
    opacity: 0;
  }

  .archive-wheel:focus-visible {
    outline: 1px solid rgba(34, 211, 238, 0.7);
    outline-offset: 3px;
  }

  .archive-wheel__toggle {
    position: absolute;
    right: 0;
    top: 50%;
    z-index: 4;
    width: 34px;
    height: 76px;
    border: 1px solid rgba(34, 211, 238, 0.36);
    border-radius: 8px;
    background: rgba(2, 2, 5, 0.58);
    color: #22d3ee;
    cursor: pointer;
    pointer-events: auto;
    transform: translateY(-50%);
    transition:
      background 0.25s ease,
      border-color 0.25s ease;
  }

  .archive-wheel__toggle:hover {
    background: rgba(8, 47, 73, 0.42);
    border-color: rgba(34, 211, 238, 0.72);
  }

  .archive-wheel__toggle-mark {
    position: absolute;
    inset: 0;
  }

  .archive-wheel__toggle-mark::before,
  .archive-wheel__toggle-mark::after {
    content: "";
    position: absolute;
    left: 12px;
    width: 8px;
    height: 1px;
    background: currentColor;
    box-shadow: 0 0 8px currentColor;
    transform-origin: left center;
    transition: transform 0.25s ease;
  }

  .archive-wheel__toggle-mark::before {
    top: 35px;
    transform: rotate(36deg);
  }

  .archive-wheel__toggle-mark::after {
    top: 41px;
    transform: rotate(-36deg);
  }

  .archive-wheel.is-collapsed .archive-wheel__toggle-mark::before {
    transform: rotate(-36deg);
  }

  .archive-wheel.is-collapsed .archive-wheel__toggle-mark::after {
    transform: rotate(36deg);
  }

  .archive-wheel__step-controls {
    position: absolute;
    right: 0;
    top: 50%;
    z-index: 3;
    width: 34px;
    height: 34px;
    pointer-events: none;
    transform: translateY(-50%);
  }

  .archive-wheel.is-collapsed .archive-wheel__step-controls {
    pointer-events: none;
  }

  .archive-wheel__step {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 26px;
    height: 26px;
    border: 1px solid rgba(34, 211, 238, 0.28);
    border-radius: 6px;
    background: rgba(2, 2, 5, 0.54);
    color: #22d3ee;
    cursor: pointer;
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, -50%);
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      opacity 0.22s ease,
      transform 0.2s ease;
  }

  .archive-wheel__step[data-wheel-step="-1"] {
    transform: translate(-50%, -72px);
  }

  .archive-wheel__step[data-wheel-step="1"] {
    transform: translate(-50%, 46px);
  }

  .archive-wheel.is-collapsed .archive-wheel__step {
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .archive-wheel__step:hover {
    background: rgba(8, 47, 73, 0.38);
    border-color: rgba(34, 211, 238, 0.68);
  }

  .archive-wheel__step:active {
    opacity: 0.82;
  }

  .archive-wheel__step-mark {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 8px;
    border-left: 1px solid currentColor;
    border-top: 1px solid currentColor;
    box-shadow: -2px -2px 8px rgba(34, 211, 238, 0.26);
  }

  .archive-wheel__step-mark--up {
    transform: translate(-50%, -32%) rotate(45deg);
  }

  .archive-wheel__step-mark--down {
    transform: translate(-50%, -68%) rotate(225deg);
  }

  .archive-wheel__rail {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: auto;
    touch-action: pan-y;
    clip-path: inset(0 0 0 0);
    transform: translateX(0);
    transition:
      clip-path 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.32s ease,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .archive-wheel.is-collapsed .archive-wheel__rail {
    clip-path: inset(0 0 0 100%);
    opacity: 0;
    pointer-events: none;
    transform: translateX(24px);
  }

  .archive-wheel__item {
    position: absolute;
    top: 50%;
    right: 0;
    width: min(300px, calc(100vw - 70px));
    min-height: 46px;
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr);
    grid-template-areas:
      "year title"
      "year artist";
    column-gap: 10px;
    align-items: center;
    border: 0;
    border-right: 1px solid rgba(113, 113, 122, 0.42);
    background: transparent;
    color: #d4d4d8;
    font: inherit;
    font-family: 'JetBrains Mono', monospace;
    text-align: right;
    padding: 7px 12px 7px 4px;
    cursor: pointer;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform-origin: right center;
    transition:
      opacity 0.45s ease,
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.35s ease,
      border-color 0.35s ease;
  }

  .archive-wheel.is-dragging .archive-wheel__item {
    transition: none;
  }

  .archive-wheel__item.is-hidden {
    display: none;
  }

  .archive-wheel__item.is-selected {
    color: #ffffff;
    border-color: rgba(34, 211, 238, 0.92);
    text-shadow: 0 0 14px rgba(34, 211, 238, 0.54);
  }

  .archive-wheel__year {
    grid-area: year;
    color: #22d3ee;
    font-size: 8px;
    letter-spacing: 0.16em;
    opacity: 0.72;
  }

  .archive-wheel__title {
    grid-area: title;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 10px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .archive-wheel__artist {
    grid-area: artist;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #71717a;
    font-size: 8px;
    letter-spacing: 0.08em;
    line-height: 1.25;
  }

  @media (max-width: 760px) {
    .archive-wheel {
      right: 6px;
      bottom: 10px;
      width: min(340px, calc(100vw - 12px));
      height: 310px;
      padding: 14px 42px 14px 12px;
    }

    .archive-wheel::before {
      right: -72px;
      width: 250px;
      height: 250px;
    }

    .archive-wheel__item {
      width: min(270px, calc(100vw - 54px));
    }
  }
</style>

<script>
  import { getSelectedWork, setSelectedWork, subscribe } from '../../lib/workSelectionStore';

  const wheel = document.getElementById('archive-wheel');
  const rail = wheel?.querySelector<HTMLElement>('[data-wheel-rail]');
  const toggle = wheel?.querySelector<HTMLButtonElement>('[data-wheel-toggle]');
  const stepButtons = Array.from(wheel?.querySelectorAll<HTMLButtonElement>('[data-wheel-step]') ?? []);
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-wheel-work]'));
  const mapNodeById = new Map<string, HTMLElement>();
  const rowGap = 48;
  const wheelScrollDistance = 110;
  const minWheelStep = 0.08;
  const wheelSettleDelay = 170;
  const dragStepDistance = 76;
  const renderRadius = 4;
  let selectedIndex = 0;
  let wheelOffset = 0;
  let dragging = false;
  let dragStartY = 0;
  let dragStartOffset = 0;
  let rotating = false;
  let settleTimer = 0;
  let layoutFrame = 0;
  let pendingWheelOffset: number | null = null;
  let visibleItemList: HTMLElement[] = [];
  let renderedItems = new Set<HTMLElement>();

  document.querySelectorAll<HTMLElement>('[data-work][data-work-id]').forEach((node) => {
    const id = node.dataset.workId;
    if (id) mapNodeById.set(id, node);
  });

  function setCollapsed(collapsed: boolean) {
    const wasCollapsed = Boolean(wheel?.classList.contains('is-collapsed'));
    if (wasCollapsed === collapsed) return;

    wheel?.classList.toggle('is-collapsed', collapsed);
    toggle?.setAttribute('aria-expanded', String(!collapsed));
    rail?.toggleAttribute('inert', collapsed);
    rail?.setAttribute('aria-hidden', String(collapsed));
    if (collapsed) {
      setSelectedWork(null);
    } else {
      layoutWheel(true);
    }
  }

  function rebuildVisibleItems() {
    visibleItemList = items.filter((item) => !item.classList.contains('is-hidden'));
  }

  function visibleItems() {
    return visibleItemList;
  }

  function clampIndex(index: number) {
    const list = visibleItems();
    if (!list.length) return 0;
    return Math.max(0, Math.min(index, list.length - 1));
  }

  function clampOffset(index: number) {
    return clampIndex(index);
  }

  function nearestIndex() {
    return clampIndex(Math.round(wheelOffset));
  }

  function clearSettleTimer() {
    if (settleTimer) {
      window.clearTimeout(settleTimer);
      settleTimer = 0;
    }
  }

  function syncFilteredItems() {
    items.forEach((item) => {
      const id = item.dataset.workId;
      const mapNode = id ? mapNodeById.get(id) : null;
      item.classList.toggle('is-hidden', Boolean(mapNode?.classList.contains('is-inactive')));
    });

    rebuildVisibleItems();

    const selectedId = getSelectedWork();
    const list = visibleItems();
    if (!list.length) {
      setSelectedWork(null);
      layoutWheel();
      return;
    }

    const selectedVisibleIndex = list.findIndex((item) => item.dataset.workId === selectedId);
    if (selectedVisibleIndex >= 0) {
      selectedIndex = selectedVisibleIndex;
      wheelOffset = selectedVisibleIndex;
    } else {
      selectedIndex = clampIndex(selectedIndex);
      wheelOffset = selectedIndex;
      if (selectedId) {
        setSelectedWork(null);
      }
    }

    layoutWheel();
  }

  function selectVisibleIndex(index: number) {
    const list = visibleItems();
    if (!list.length) return;
    selectedIndex = clampIndex(index);
    wheelOffset = selectedIndex;
    const nextId = list[selectedIndex]?.dataset.workId ?? null;
    const changed = getSelectedWork() !== nextId;
    setSelectedWork(nextId);
    if (!changed) layoutWheel();
  }

  function setWheelOffset(index: number) {
    pendingWheelOffset = clampOffset(index);
    if (layoutFrame) return;

    layoutFrame = requestAnimationFrame(() => {
      layoutFrame = 0;
      if (pendingWheelOffset === null) return;
      wheelOffset = pendingWheelOffset;
      pendingWheelOffset = null;
      layoutWheel();
    });
  }

  function flushWheelOffset() {
    if (pendingWheelOffset === null) return;
    cancelAnimationFrame(layoutFrame);
    layoutFrame = 0;
    wheelOffset = pendingWheelOffset;
    pendingWheelOffset = null;
  }

  function snapToNearest() {
    clearSettleTimer();
    flushWheelOffset();
    rotating = false;
    selectVisibleIndex(nearestIndex());
  }

  function scheduleSnap() {
    clearSettleTimer();
    settleTimer = window.setTimeout(snapToNearest, wheelSettleDelay);
  }

  function rotateBy(delta: number) {
    const list = visibleItems();
    if (!list.length || !delta) return;
    setCollapsed(false);
    rotating = true;
    setWheelOffset(wheelOffset + delta);
    scheduleSnap();
  }

  function layoutWheel(force = false) {
    if (!force && wheel?.classList.contains('is-collapsed')) return;

    const list = visibleItems();
    const selectedId = getSelectedWork();
    if (!list.length) {
      rail?.setAttribute('data-empty', 'true');
      renderedItems.forEach((item) => {
        item.classList.remove('is-selected');
        item.style.visibility = 'hidden';
        item.style.opacity = '0';
        item.style.pointerEvents = 'none';
      });
      renderedItems.clear();
      return;
    }

    rail?.removeAttribute('data-empty');
    const selectedVisibleIndex = list.findIndex((item) => item.dataset.workId === selectedId);
    if (!rotating && selectedVisibleIndex >= 0) {
      selectedIndex = selectedVisibleIndex;
      wheelOffset = selectedVisibleIndex;
    }

    const centerIndex = nearestIndex();
    const startIndex = Math.max(0, Math.floor(wheelOffset) - renderRadius);
    const endIndex = Math.min(list.length - 1, Math.ceil(wheelOffset) + renderRadius);
    const nextRenderedItems = new Set<HTMLElement>();

    for (let visibleIndex = startIndex; visibleIndex <= endIndex; visibleIndex += 1) {
      const item = list[visibleIndex];
      if (!item) continue;
      nextRenderedItems.add(item);
      const distance = visibleIndex - wheelOffset;
      const abs = Math.abs(distance);
      const curveX = Math.min(54, abs * abs * 5.5);
      const rotate = distance * -2.8;
      const opacity = abs < 0.45 ? 1 : abs < 1.45 ? 0.86 : abs < 2.45 ? 0.68 : 0.42;
      const scale = abs < 0.45 ? 1 : abs < 1.45 ? 0.97 : abs < 2.45 ? 0.92 : 0.86;

      item.classList.toggle('is-selected', visibleIndex === centerIndex);
      item.style.visibility = 'visible';
      item.style.opacity = String(opacity);
      item.style.transform = `translate3d(${-curveX}px, ${distance * rowGap}px, 0) rotate(${rotate}deg) scale(${scale})`;
      item.style.pointerEvents = abs > 3 ? 'none' : 'auto';
    }

    renderedItems.forEach((item) => {
      if (nextRenderedItems.has(item)) return;
      item.classList.remove('is-selected');
      item.style.visibility = 'hidden';
      item.style.opacity = '0';
      item.style.pointerEvents = 'none';
    });
    renderedItems = nextRenderedItems;
  }

  wheel?.addEventListener('wheel', (event) => {
    event.preventDefault();
    const modeMultiplier = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? window.innerHeight : 1;
    const rawDelta = event.deltaY * modeMultiplier;
    const direction = Math.sign(rawDelta);
    if (!direction) return;
    const delta = direction * Math.max(Math.abs(rawDelta) / wheelScrollDistance, minWheelStep);
    rotateBy(delta);
  }, { passive: false });

  wheel?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
      event.preventDefault();
      selectVisibleIndex(selectedIndex + 1);
    }
    if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
      event.preventDefault();
      selectVisibleIndex(selectedIndex - 1);
    }
  });

  wheel?.addEventListener('pointerdown', (event) => {
    if ((event.target as HTMLElement).closest('[data-wheel-toggle]')) return;
    if ((event.target as HTMLElement).closest('[data-wheel-step]')) return;
    setCollapsed(false);
    clearSettleTimer();
    rotating = true;
    dragging = true;
    wheel.classList.add('is-dragging');
    dragStartY = event.clientY;
    dragStartOffset = wheelOffset;
    wheel.setPointerCapture(event.pointerId);
  });

  wheel?.addEventListener('pointermove', (event) => {
    if (!dragging) return;
    const delta = (event.clientY - dragStartY) / dragStepDistance;
    setWheelOffset(dragStartOffset - delta);
  });

  wheel?.addEventListener('pointerup', (event) => {
    dragging = false;
    wheel.classList.remove('is-dragging');
    if (wheel.hasPointerCapture(event.pointerId)) {
      wheel.releasePointerCapture(event.pointerId);
    }
    snapToNearest();
  });

  wheel?.addEventListener('pointercancel', (event) => {
    dragging = false;
    wheel.classList.remove('is-dragging');
    if (wheel.hasPointerCapture(event.pointerId)) {
      wheel.releasePointerCapture(event.pointerId);
    }
    snapToNearest();
  });

  items.forEach((item) => {
    item.addEventListener('click', () => {
      if (!item.classList.contains('is-hidden')) {
        setCollapsed(false);
        setSelectedWork(item.dataset.workId ?? null);
      }
    });
  });

  toggle?.addEventListener('click', () => {
    setCollapsed(!wheel?.classList.contains('is-collapsed'));
  });

  stepButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const direction = Number(button.dataset.wheelStep);
      if (!direction) return;
      clearSettleTimer();
      rotating = false;
      selectVisibleIndex(selectedIndex + direction);
    });
  });

  subscribe(() => layoutWheel());
  window.addEventListener('work-filters-applied', syncFilteredItems);
  window.addEventListener('beforeunload', () => {
    cancelAnimationFrame(layoutFrame);
    clearSettleTimer();
  });
  syncFilteredItems();
</script>
